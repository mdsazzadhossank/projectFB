# ------------------------------------------------------------------
# MessageHub — environment configuration
# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
# ------------------------------------------------------------------

# --- Frontend (Vite) — values are exposed to the browser ---
# Pusher realtime (channel 'chat', cluster 'ap2' by default).
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=ap2

# Facebook OAuth app (used by the "Connect Facebook" flow to authorize a page).
# Leave blank to hide the connect button behind a "not configured" toast.
VITE_FACEBOOK_APP_ID=

# Shared API secret, sent as the `X-MessageHub-Secret` header on write calls.
# When empty, backend write auth is disabled (local development only).
VITE_MESSAGEHUB_API_SECRET=

# --- Backend (PHP) — server-side only, never expose these ---
# API auth secret for the PHP endpoints. When empty, auth is disabled (dev mode).
# Must match VITE_MESSAGEHUB_API_SECRET for the frontend to authorize writes.
MESSAGEHUB_API_SECRET=

# Facebook Messenger outbound sending (Graph API). Optional.
# Requires a Page token + Page ID. The client must also send `recipient_id` per
# message for the backend to know which customer to deliver to.
MESSAGEHUB_FB_PAGE_ID=
MESSAGEHUB_FB_PAGE_TOKEN=

# Meta webhook verification token (used by api/webhooks/meta.php).
# Register this exact value in your Meta app's webhook settings.
MESSAGEHUB_WEBHOOK_VERIFY_TOKEN=

# --- Pusher realtime (server side, used to broadcast webhook events) ---
# Same app as VITE_PUSHER_KEY, but PUSHER_SECRET stays server-only.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# MySQL connection (defaults match XAMPP out of the box).
DB_HOST=localhost
DB_NAME=messagehub
DB_USER=root
DB_PASS=
